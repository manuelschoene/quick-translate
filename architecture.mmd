classDiagram
    namespace models {
        class ProviderID {
            <<enum>>
            DeepL = 1
            +String() string
        }

        class Language {
            +string Tag
            +string Name
            +bool Source
            +bool Target
            +bool Stable
        }

        class Translation {
            +int64 ID
            +string Text
            +string Translation
            +time.Time CreatedAt
            +ProviderID ProviderID
            +*string SourceTag
            +string TargetTag
            +bool Detection
        }
    }

    namespace system {
        class Files {
            +Path(r Resource, parts ...string) string
            +Read(r Resource, parts ...string) ([]byte, error)
            +Write(r Resource, content []byte, parts ...string) error
            +EnsureFile(r Resource, content []byte, parts ...string) (bool, error)
            +Remove(r Resource, parts ...string) (bool, error)
            +Purge() ([]File, error)
            +Removals() ([]File, error)
            +Status() (*Report, error)
        }

        class SystemService {
            <<service>>
            +ServiceStartup() error
            +Locale() (string, error)
        }

        class Actions {
            +func() Translate
            +func() Open
        }

        class Notifier {
            <<service>>
            +ServiceStartup() error
            +ServiceShutdown() error
            +StartupFailed(err error)
        }

        class Report {
            +string Executable
            +string Environment
            +[]File Integration
            +[]File UserFiles
        }
    }

    namespace store {
        class StoreService {
            <<service>>
            +ServiceStartup() error
            +ServiceShutdown() error
            +NewHistory() *HistoryRepository
            +NewLanguage() *LanguageRepository
        }

        class HistoryRepository {
            +Append(ctx, t *Translation) error
            +Previous(ctx, ID, window) (Translation, error)
            +Next(ctx, ID) (Translation, error)
            +Latest(ctx) (Translation, error)
            +HasPrevious(ctx, ID, window) (bool, error)
            +HasNext(ctx, ID) (bool, error)
        }

        class LanguageRepository {
            +Get(ctx, ID) ([]Language, error)
            +Put(ctx, ID, languages []Language) error
            +FetchedAt(ctx, IDs) (map~ProviderID, time.Time~, error)
            +Delete(ctx, ID) error
        }
    }

    namespace config {
        class ConfigService {
            <<service>>
            +ServiceStartup() error
            +DefaultProvider() (ProviderID, error)
            +Providers() ([]ProviderID, error)
            +Provider(ID) (decode func(any) error, error)
            +Preferences() LanguagePreferences
            +HistoryLimit() int
        }

        class LanguagePreferences {
            +string Source
            +string Target
        }
    }

    namespace provider {
        class ProviderService {
            <<service>>
            +Providers() ([]Info, error)
            +Current() (Info, error)
            +Select(ID) error
            +Translator() (*Translator, error)
            +Fetcher(ID) (*Fetcher, error)
            +OnChange(hook func(*Fetcher) error)
        }

        class Info {
            +ProviderID ID
            +string Name
            +bool Detection
        }

        class Translator {
            +Info() Info
            +Translate(ctx, Request) (Result, error)
        }

        class Fetcher {
            +Info() Info
            +Languages(ctx) ([]Language, error)
        }

        class implementation {
            <<interface>>
            -translate(ctx, Request) (Result, error)
            -languages(ctx) ([]Language, error)
        }

        class deepl
    }

    namespace language {
        class LanguageService {
            <<service>>
            +Options() (Options, error)
            +Selection() (Selection, error)
            +SetSource(tag string) error
            +Detect() error
            +SetTarget(tag string) error
            +Switch() error
            +Snapshot() (Snapshot, error)
            +Adopt(entry Translation) error
            +SetDetected(ID, tag string)
        }

        class Selection {
            +bool Detection
            +string Source
            +string Target
            +string Detected
        }

        class catalog {
            -ProviderID provider
            -[]Language sources
            -[]Language targets
            -matcher sourceMatcher
            -matcher targetMatcher
        }

        class refresher {
            +Start(ctx)
            +Trigger()
            +Wait()
        }
    }

    namespace clipboard {
        class ClipboardService {
            <<service>>
            +ServiceStartup() error
            +Read(ctx) (string, error)
            +Write(ctx, text string) error
        }

        class backend {
            <<interface>>
            -read(ctx) (string, error)
            -write(ctx, text string) error
        }
    }

    namespace translation {
        class TranslationService {
            <<service>>
            +Current() *Translation
            +Retranslate(ctx) error
            +Copy(ctx) error
            +Navigation(ctx) (Navigation, error)
            +Previous(ctx) error
            +Next(ctx) error
            +TranslateSelection()
            +Latest() error
        }

        class Navigation {
            +bool HasPrevious
            +bool HasNext
        }
    }

    namespace cli {
        class CliPackage {
            +Run(args []string, version string) (bool, int)
        }

        class interaction {
            <<interface>>
            +Write(p []byte) (int, error)
            -confirm(question confirmation) bool
        }

        class terminal
    }

    Translation ..> ProviderID
    Info ..> ProviderID

    SystemService ..> Files
    SystemService ..> Actions
    Notifier ..> Files
    Files ..> Report

    StoreService ..> Files
    StoreService ..> Notifier
    StoreService ..> HistoryRepository
    StoreService ..> LanguageRepository
    HistoryRepository ..> Translation
    LanguageRepository ..> Language

    ConfigService ..> Files
    ConfigService ..> Notifier
    ConfigService ..> LanguagePreferences

    ProviderService ..> ConfigService : configuration
    ProviderService ..> Translator
    ProviderService ..> Fetcher
    Translator ..> implementation
    Fetcher ..> implementation
    deepl ..|> implementation

    LanguageService ..> ConfigService : configuration
    LanguageService ..> LanguageRepository : storage
    LanguageService ..> ProviderService : OnChange hook
    LanguageService ..> SystemService : Locale
    LanguageService ..> catalog
    LanguageService ..> Selection
    LanguageService ..> refresher

    ClipboardService ..> Notifier
    ClipboardService ..> backend

    TranslationService ..> ProviderService : Translator, Select
    TranslationService ..> LanguageService : Snapshot, Adopt, SetDetected
    TranslationService ..> ClipboardService : Read, Write
    TranslationService ..> HistoryRepository
    TranslationService ..> ConfigService : HistoryLimit
    TranslationService ..> Navigation

    CliPackage ..> Files
    CliPackage ..> interaction
    terminal ..|> interaction
