    namespace system {
        class SystemPackage {
            +ApplicationID string
            +ErrUnsupported error
            -integrate(files *FileService) error
            +Purge(files *FileService) ([]File, error)
            +Removals(files *FileService) ([]File, error)
            +Status(files *FileService) (*Report, error)
        }

        class Resource {
            <<enumeration>>
            ConfigRoot
            Settings
            DataRoot
            History
            CacheRoot
            Languages
            Launcher
            Icon
            Autostart
            WindowRules
        }

        class FileService {
            -table []entry

            +NewFileService() *FileService
            +Path(r Resource, parts ...string) string
            +Exists(r Resource, parts ...string) bool
            +Read(r Resource, parts ...string) ([]byte, error)
            +Write(r Resource, content []byte, parts ...string) error
            +EnsureDirectory(r Resource, parts ...string) error
            +EnsureFile(r Resource, content []byte, parts ...string) (bool, error)
            +Narrow(r Resource, parts ...string)
            +Remove(r Resource, parts ...string) (bool, error)
        }

        class category {
            <<enumeration>>
            internal
            data
            registered
            installed
            merged
        }

        class entry {
            -resource Resource
            -name string
            -path string
            -mode os.FileMode
            -category category
            -parent Resource
        }

        class Integration {
            -app *application.App
            -files *FileService
            -actions Actions
            -trayIcon []byte

            +ServiceStartup(ctx context.Context, options ServiceOptions) error
            -ensureAutostart() error
            -showInTray()
        }

        class Actions {
            +func() Translate
            +func() Open
        }

        class File {
            +string Name
            +string Path
            +bool Present
        }

        class Report {
            +string Executable
            +string Environment
            +[]File Integration
            +[]File UserFiles
        }
    }

