    namespace transport {
        class TransportPackage {
            +NewAdapter(app *application.App) *Adapter
        }

        class TranslationDto {
            +string Source
            +string Target
            +string DetectedSource
            +string Translation
            +bool HasPrevious
            +bool HasNext
        }

        class LanguageDto {
            +string PreferredSource
            +string PreferredTarget
            +*Language Detection
            +[]*Language SourceLanguages
            +[]*Language TargetLanguages
        }

        class ProviderDto {
            +string Current
            +[]string Providers
        }

        class FullDto {
            +*ProviderDto Provider
            +*LanguageDto Languages
            +*TranslationDto Translation
        }

        class Adapter {
            -app *application.App
            -files *FileService
            -core *Core
            -mutex sync.Mutex

            +ServiceShutdown() error
            +Show()
            +Restore()
            +Hide()
            +State() *FullDto
            +ChangeProvider(slug string) (*FullDto, error)
            +ChangeSource(tag string) (*TranslationDto, error)
            +ChangeTarget(tag string) (*TranslationDto, error)
            +SwitchLanguages() (*TranslationDto, error)
            +PreviousTranslation() (*FullDto, error)
            +NextTranslation() (*FullDto, error)
            +CopyTranslation() error
        }
    }

