{
    "name": "quick-translate",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:dev": "vite build --minify false --mode development",
        "preview": "vite preview",
        "types": "vue-tsc --noEmit",
        "lint": "eslint . --fix",
        "lint:check": "eslint . --cache --cache-location='/tmp/eslint'",
        "lint:fix": "eslint . --fix --cache --cache-location='/tmp/eslint' --quiet || true",
        "format": "prettier . --write --no-editorconfig",
        "format:check": "prettier . --check --no-editorconfig --cache --cache-location=/tmp/prettier",
        "format:fix": "prettier . --write --no-editorconfig --cache --cache-location=/tmp/prettier"
    },
    "dependencies": {
        "@lucide/vue": "^1.66.0",
        "@wailsio/runtime": "3.0.0",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "vue3-simple-icons": "^16.10.0"
    },
    "devDependencies": {
        "@babel/types": "^8.0.10",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.13.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-attributes": "^1.0.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vue-tsc": "^3.3.14"
    }
}
